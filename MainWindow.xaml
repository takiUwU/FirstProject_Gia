<Window x:Class="FirstProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FirstProject"
        mc:Ignorable="d"
        Title="Окно материалов" Height="720" Width="1280" WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Grid Margin="10,10,0,10">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="9*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <Image Source="/icon.ico" VerticalAlignment="Top" HorizontalAlignment="Left"/>
        <Label Content="Арома дом" FontFamily="Georgia" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="25"/>
        <ListBox Grid.Row="1" x:Name="ListBoxProducts" SelectionChanged="ListBoxProducts_SelectionChanged" FontFamily="Georgia" SelectionMode="Multiple">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="MaterialPanel" Orientation="Vertical"/>
        </ScrollViewer>
        <Button Grid.Row="4" VerticalAlignment="Bottom" HorizontalAlignment="Right" Content="Создать новый материал" FontFamily="Georgia" FontSize="30" Margin="20" Click="Button_Click"/>
    </Grid>
</Window>
